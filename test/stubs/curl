#!/usr/bin/env bash
# Fake `curl` standing in for Ollama in soapcap's flow tests (test/flow.sh).
# STUB_OLLAMA_MODE: up (default) | down (connection refused, exit 7) |
# error (generate returns an Ollama-style error) | empty (generate returns
# an empty response). STUB_OLLAMA_MODEL: the one model "pulled".
# STUB_CURL_LOG receives each URL; STUB_CURL_PAYLOAD the last -d payload
# (read from the file for -d @FILE); STUB_CURL_ARGS every raw argument list.
# Bonsai's llama-server: /health answers only while the stub llama-server
# is running (per STUB_LLAMA_LOG), or always with STUB_LLAMA_BUSY=1.
# STUB_BONSAI_REPLY: ok (default) | error | length | hang.
# Structured-style requests (a schema in Ollama's `format` or Bonsai's
# `response_format`) get schema-shaped JSON back instead of a prose note.
# STUB_STRUCT_MODE: ok (default) | invalid (always malformed) |
# invalid_once (malformed first, then ok; needs STUB_STRUCT_COUNT, a file)
# | length (cut off at the output cap). A request whose schema requires
# mental_status (SOAP's Objective pass) gets that shape instead, per
# STUB_OBJ_MODE: ok (default) | invalid (always malformed); its risk status
# is STUB_OBJ_RISK (default not_addressed). STUB_CURL_PAYLOG, if set, gets
# every request payload, one compact JSON per line.
[ -n "${STUB_CURL_ARGS:-}" ] && printf '%s\n' "$*" >> "$STUB_CURL_ARGS"
url=""; payload=""; out=""
while [ $# -gt 0 ]; do
  case "$1" in
    -d) case "$2" in @*) payload=$(cat "${2#@}") ;; *) payload="$2" ;; esac; shift 2 ;;
    -o) out="$2"; shift 2 ;;
    http*) url="$1"; shift ;;
    *) shift ;;
  esac
done
# An unload request (keep_alive 0, no prompt) is logged as "unload MODEL",
# and kept out of the payload files the tests read.
if [ -n "$payload" ] && printf '%s' "$payload" | jq -e '.keep_alive == 0 and (has("prompt") | not)' >/dev/null 2>&1; then
  [ -n "${STUB_CURL_LOG:-}" ] && echo "unload $(printf '%s' "$payload" | jq -r .model)" >> "$STUB_CURL_LOG"
  exit 0
fi
[ -n "${STUB_CURL_LOG:-}" ] && echo "$url" >> "$STUB_CURL_LOG"
[ -n "$payload" ] && [ -n "${STUB_CURL_PAYLOAD:-}" ] && printf '%s' "$payload" > "$STUB_CURL_PAYLOAD"
[ -n "$payload" ] && [ -n "${STUB_CURL_PAYLOG:-}" ] && printf '%s' "$payload" | jq -c . >> "$STUB_CURL_PAYLOG"

mode="${STUB_OLLAMA_MODE:-up}"
emit() { if [ -n "$out" ]; then printf '%s' "$1" > "$out"; else printf '%s' "$1"; fi; }

# A schema-carrying request? Then answer with structured JSON (as a string)
# plus a stop reason, per STUB_STRUCT_MODE.
structured=no
[ -n "$payload" ] && printf '%s' "$payload" | jq -e 'has("format") or has("response_format")' >/dev/null 2>&1 && structured=yes
struct_reply() {
  local smode="${STUB_STRUCT_MODE:-ok}" n=0
  if printf '%s' "$payload" | jq -e '(.format // .response_format.json_schema.schema).required | index("mental_status")' >/dev/null 2>&1; then
    STRUCT_DONE=stop
    if [ "${STUB_OBJ_MODE:-ok}" = invalid ]; then STRUCT_JSON='{"mental_status": {'; return; fi
    STRUCT_JSON=$(jq -nc --arg r "${STUB_OBJ_RISK:-not_addressed}" '{
      mental_status: {engagement: "stub engaged", affect: "stub affect", mood: "stub mood",
        speech: "stub speech", thought_process: "stub thought", insight: "stub insight",
        judgment: "stub judgment", psychomotor: "stub psychomotor"},
      risk: {status: $r, summary: ""},
      risk_kind: (if $r == "disclosed" then "HI" else "none" end)}')
    return
  fi
  if [ "$smode" = invalid_once ]; then
    n=$(cat "$STUB_STRUCT_COUNT" 2>/dev/null || echo 0); echo $((n + 1)) > "$STUB_STRUCT_COUNT"
    [ "$n" -eq 0 ] && smode=invalid || smode=ok
  fi
  case "$smode" in
    invalid) STRUCT_JSON='{"subjective": "cut off mid-'; STRUCT_DONE=stop ;;
    length)  STRUCT_JSON='{"subjective": "cut off at the cap'; STRUCT_DONE=length ;;
    *) STRUCT_JSON=$(jq -nc '{
         subjective: "Stub structured subjective.",
         objective_observations: [{line: 1, speaker: "Therapist", text: "Stub observation."}],
         assessment: "Stub structured assessment.",
         response: "Stub structured response.",
         risk: {status: "disclosed", summary: "Stub risk summary."},
         safety_plan: {warning_signs: ["a stub sign"], coping_strategies: [], supports: [], emergency_steps: ["calling 988"]},
         interventions_used: [{line: 1, action: "reviewed a stub exercise"}],
         plan_items: [{line: 2, actor: "client", action: "do a stub task"}]}')
       STRUCT_DONE=stop ;;
  esac
}

case "$url" in
  */api/tags)
    [ "$mode" = down ] && exit 7
    printf '{"models":[{"name":"%s"}]}' "${STUB_OLLAMA_MODEL:-llama3.1:8b}" ;;
  */api/generate)
    [ "$mode" = down ] && exit 7
    # A streaming request gets its reply as NDJSON, split in two, with
    # done_reason only on the last chunk, as Ollama sends it.
    if printf '%s' "$payload" | jq -e '.stream == true' >/dev/null 2>&1; then
      emit() {
        local body
        body=$(printf '%s' "$1" | jq -c 'if has("response") then
            (.response | length / 2 | floor) as $n
            | ({response: .response[:$n]}, (. + {response: .response[$n:], done: true}))
          else . end')
        if [ -n "$out" ]; then printf '%s\n' "$body" > "$out"; else printf '%s\n' "$body"; fi
      }
    fi
    case "$mode" in
      error) emit '{"error":"boom"}' ;;
      empty) emit '{"response":""}' ;;
      *) if [ "$structured" = yes ]; then
           struct_reply
           emit "$(jq -nc --arg r "$STRUCT_JSON" --arg d "$STRUCT_DONE" '{response: $r, done_reason: $d}')"
         else
           emit '{"response":"SUBJECTIVE:\nStub note\n\nOBJECTIVE:\nNo observable presentation details available from a text-only transcript.\n\nASSESSMENT:\nStub assessment.\n\nPLAN:\nStub plan."}'
         fi ;;
    esac ;;
  */health)
    [ "${STUB_LLAMA_BUSY:-}" = 1 ] && { printf '{"status":"ok"}'; exit 0; }
    [ "$(tail -n 1 "${STUB_LLAMA_LOG:-/dev/null}" 2>/dev/null | cut -d' ' -f1)" = started ] || exit 7
    printf '{"status":"ok"}' ;;
  */v1/chat/completions)
    note='SUBJECTIVE:\nBonsai stub note\n\nOBJECTIVE:\nStub.\n\nASSESSMENT:\nStub.\n\nPLAN:\nStub.'
    if [ "$structured" = yes ]; then
      struct_reply
      emit "$(jq -nc --arg c "$STRUCT_JSON" --arg d "$STRUCT_DONE" '{choices: [{message: {content: $c}, finish_reason: $d}]}')"
      exit 0
    fi
    case "${STUB_BONSAI_REPLY:-ok}" in
      error)  emit '{"error":{"code":500,"message":"boom","type":"server_error"}}' ;;
      length) emit "{\"choices\":[{\"message\":{\"content\":\"$note\"},\"finish_reason\":\"length\"}]}" ;;
      hang)   sleep 15; exit 28 ;;
      *)      emit "{\"choices\":[{\"message\":{\"content\":\"$note\"},\"finish_reason\":\"stop\"}]}" ;;
    esac ;;
esac
