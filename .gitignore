# Never commit captured PHI or working files.
*.transcript
*.transcript.txt
# ...except the fictional sample corpus (see samples/transcripts/README.md).
!samples/transcripts/*.transcript
*.srt
*.vtt
*.json
*.jsonl
*.m4a
*.wav
*.aiff
*.mp3
*.mp4
/out/
/notes/
/tmp/
.DS_Store

# Local config override (keep config.example.sh tracked)
config.sh

# macOS / editor artifacts
._*
*.swp
*.swo
.vscode/
.idea/

# Local development notes (not for public history — see the file itself)
DEV_NOTES.local.md

# Swift package build output (tools/deidentify-helper) — Package.resolved
# IS tracked, pinning exact dependency versions for reproducible builds.
tools/deidentify-helper/.build/
tools/deidentify-helper/.swiftpm/
tools/session-app/.build/
tools/session-app/build/
tools/session-app/.swiftpm/
